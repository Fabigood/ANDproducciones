# Auto detect text files and perform LF normalization
* text=auto

# Binarios: nada de normalización de saltos de línea, que los corrompe.
*.woff2 binary
*.png   binary
*.jpg   binary
*.ico   binary

# Los scripts de despliegue se ejecutan en bash (Git Bash o el VPS): con CRLF
# fallan con "$'\r': command not found", así que van siempre en LF.
*.sh text eol=lf
